# Copy this file to .env.local and fill in the values
# Get these from the Supabase dashboard: Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# RESEND_API_KEY is intentionally NOT listed here — it is a server-only secret.
# Production: set via `supabase secrets set RESEND_API_KEY=…` (edge functions).
# Local dev: export RESEND_API_KEY in your shell rc; .mcp.json picks it up via
# ${RESEND_API_KEY} interpolation. Never expose Resend via a VITE_* var.
# See docs/RESEND.md for the full setup.
